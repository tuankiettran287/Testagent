{
  "name": "testagent-browser-runner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "browser:install": "playwright install chromium",
    "test:agent": "playwright test --config playwright.agent.config.ts",
    "typecheck:agent": "tsc -p tsconfig.agent.json",
    "report:agent": "playwright show-report ../output/playwright/agent-cases/html"
  },
  "dependencies": {
    "@playwright/test": "1.58.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
